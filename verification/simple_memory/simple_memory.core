CAPI=2:
name: socet:digital-lib:simple_memory:0.0.2
description: Simple memory using bus_protocol_if for testing bus managers

filesets:
    rtl:
        depend:
            - "socet:digital-lib:bus_protocol_if"
        files:
            - simple_memory.sv
        file_type: systemVerilogSource


targets:
    default:
        filesets:
            - rtl
        toplevel: simple_memory
