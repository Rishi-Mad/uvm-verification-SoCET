CAPI=2:
name: socet:digital-lib:shift_register:0.0.2
description: Parameterizable shift register 

filesets:
    rtl:
        files:
            - src/socetlib_shift_reg.sv
        file_type: systemVerilogSource

    tb:
        files:
            - tb/tb_socetlib_shift_reg.sv
        file_type: systemVerilogSource

    verilator_wrapper:
        files:
            - "tb/tb_socetlib_shift_reg.cpp"
        file_type: cppSource

targets:
    default: &default
        filesets:
            - rtl
        toplevel: socetlib_shift_reg
    
    sim:
        <<: *default
        description: Simulate w/TB
        default_tool: xcelium
        filesets_append:
            - tb
            - "tool_verilator? (verilator_wrapper)"
        toplevel: tb_socetlib_shift_reg
        tools:
            verilator:
                verilator_options:
                    - --cc
                    - --trace
                    - --exe
                    - --timing
                    - --coverage
                make_options:
                    - -j

    gui:
        <<: *default
        description: Simulate TB with GUI
        default_tool: xcelium
        filesets_append:
            - tb
        toplevel: tb_socetlib_shift_reg
        tools:
            xcelium:
                xrun_options:
                    - -gui
                    - -access +rwc
    lint:
        <<: *default
        description: Linting
        default_tool: veriblelint
