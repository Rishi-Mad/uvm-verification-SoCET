CAPI=2:
name: socet:digital-lib:cdc_fifo:0.0.1
description: FIFO for clock domain crossing

filesets:
    rtl:
        files:
            - src/socetlib_cdc_fifo_mem.sv
            - src/socetlib_bin2gray.sv
            - src/socetlib_cdc_fifo.sv
        file_type: systemVerilogSource

    tb:
        files:
            - tb/cdc_tb.sv
        file_type: systemVerilogSource
    
    uvm_tb:
        files:
            - tb/Verification_F26/interface.sv

            # Write agent (included by cdc_fifo_pkg.sv)
            - tb/Verification_F26/write_agent/cdc_write_item.sv: {is_include_file: true, include_path: tb/Verification_F26}
            - tb/Verification_F26/write_agent/cdc_write_sequence.sv: {is_include_file: true, include_path: tb/Verification_F26}
            - tb/Verification_F26/write_agent/cdc_write_sequencer.sv: {is_include_file: true, include_path: tb/Verification_F26}
            - tb/Verification_F26/write_agent/cdc_write_driver.sv: {is_include_file: true, include_path: tb/Verification_F26}
            - tb/Verification_F26/write_agent/cdc_write_monitor.sv: {is_include_file: true, include_path: tb/Verification_F26}
            - tb/Verification_F26/write_agent/cdc_write_agent.sv: {is_include_file: true, include_path: tb/Verification_F26}

            # UVM test
            - tb/Verification_F26/tests/cdc_fifo_basic_test.sv: {is_include_file: true, include_path: tb/Verification_F26}

            # Package and top-level module
            - tb/Verification_F26/cdc_fifo_pkg.sv
            - tb/Verification_F26/tb_top.sv

        file_type: systemVerilogSource

targets:
    default: &default
        filesets:
            - rtl
        toplevel: socetlib_cdc_fifo
        # No parameters?

    uvm_sim:
        <<: *default
        description: CDC FIFO UVM Verification
        default_tool: verilator
        filesets_append:
            - uvm_tb
        toplevel: tb_top

        tools:
            verilator:
                verilator_options:
                    - --binary
                    - --timing
                    - -Wno-fatal

    sim:
        <<: *default
        description: Simulate w/TB
        default_tool: verilator
        filesets_append:
            - tb
        toplevel: tb_socetlib_cdc_fifo
        tools:
            verilator:
                verilator_options:
                    - --binary
                    - --trace-fst
                    - --trace-structs
                    - --coverage
                    - -Wno-WIDTHTRUNC
                    - -Wno-WIDTHEXPAND
                make_options:
                    - -j

            vcs:
                vcs_options:
                    - -assert svaext
                    - -debug_access+pp
                    - -debug_access+all
                    - -debug_pp +vcd+vcdpluson
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t ps

    gui:
        <<: *default
        description: Simulate TB with GUI
        default_tool: xcelium
        filesets_append:
            - tb
        toplevel: tb_socetlib_cdc_fifo
        tools:
            xcelium:
                xrun_options:
                    - -gui
                    - -access +rwc

    lint:
        <<: *default
        filesets_append:
            - tb
        description: Linting
        default_tool: veriblelint

parameters:
    coverage_file:
        datatype: file
        default: "coverage.dat"
        description: "Name of coverage file for Verilator coverage reporting"
        paramtype: plusarg