CAPI=2:
name: socet:digital-lib:apb_completer:0.0.3
description: Parameterizable APB Completer (AMBA 5)

filesets:
    rtl:
        depend:
            - "socet:digital-lib:bus_protocol_if"
            - "socet:digital-lib:apb_if"
        files:
            - src/socetlib_apb_completer.sv
        file_type: systemVerilogSource


    tb:
        depend:
            - "socet:digital-lib:simple_memory"
        files:
            - tb/tb_socetlib_apb_completer.sv
        file_type: systemVerilogSource

targets:
    default: &default
        filesets:
            - rtl
        toplevel: socetlib_apb_completer


    sim:
        <<: *default
        filesets_append:
            - tb
        description: Simulate w/TB
        default_tool: xcelium
        toplevel: tb_socetlib_apb_completer
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps

    lint:
        filesets:
            - rtl
            - tb
        description: Linting
        default_tool: veriblelint
        toplevel: tb_socetlib_apb_completer
        tools:
            veriblelint:
                verible_lint_args: ['--autofix=inplace-interactive', '--rules_config_search']

